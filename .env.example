# Copy to .env and fill in.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for sqlite (default, no setup needed). Set to a Postgres URL
# (e.g. postgres://user:pass@localhost:5432/medical_imaging_suite) to match
# docker-compose/cloud.
DATABASE_URL=

# Leave unset to run Celery tasks synchronously in-process (no worker/broker
# needed for local dev or tests). Set to redis://localhost:6379/0 (or the
# `redis` service in docker-compose) to actually queue jobs to a worker.
CELERY_BROKER_URL=
